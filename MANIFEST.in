include README.md requirements.lock LICENSE NOTICE THIRD_PARTY_NOTICES.md
recursive-include THIRD_PARTY_LICENSES *
recursive-include docs *.md *.json
recursive-include scripts *.py *.sh
recursive-include macos *.swift *.json *.md
prune data
prune backups
prune logs
prune .venv
global-exclude *.py[cod]
