# Local-only by default. Set 0.0.0.0 only behind deliberate network protection.
MIA_BIND=127.0.0.1

# Set true only when accessing Mia through HTTPS.
MIA_COOKIE_SECURE=false

# Optional API compatible with Chat Completions and tool calling.
# Configuration belongs to this installation. Never commit a real key.
MIA_AI_ENABLED=false
MIA_AI_BASE_URL=
MIA_AI_MODEL=
MIA_AI_API_KEY=
MIA_AI_DAILY_CALL_LIMIT=20

